# Normalise line endings by default.
* text=auto

# Engineering scripts must stay LF so they run on Unix hosts.
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf

# Doxygen configuration and includes stay LF.
Doxyfile text eol=lf
*.cfg text eol=lf
*.dox text eol=lf

# Windows batch helpers stay CRLF.
*.{cmd,[cC][mM][dD]} text eol=crlf
*.{bat,[bB][aA][tT][tT]} text eol=crlf

# Lock files are text but never diff-merged loosely.
package-lock.json text eol=lf
*.json text eol=lf

# Truly binary assets are never rewritten by Git.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
